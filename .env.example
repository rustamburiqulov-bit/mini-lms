# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# For local PostgreSQL: postgres://username:password@localhost:5432/lms_db
# For cloud PostgreSQL (Neon / Supabase / Render): postgresql://user:pass@ep-xyz.region.neon.tech/lms_db?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lms_db
DB_SSL=false

# Authentication Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_characters_long!
JWT_EXPIRES_IN=24h

# Client Origin (CORS)
CLIENT_ORIGIN=http://localhost:5000
